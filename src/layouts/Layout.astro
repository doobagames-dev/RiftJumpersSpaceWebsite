---
const { title = 'Rift Jumpers' } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#000000" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Michroma&display=swap" />
		<link rel="preload" href="/fonts/akira-expanded.otf" as="font" type="font/otf" crossorigin />
		<title>{title}</title>
	</head>
	<body class="h-full">
		<slot />
	</body>
</html>

