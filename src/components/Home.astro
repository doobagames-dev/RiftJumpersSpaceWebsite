---
import astroLogo from '../assets/astro.svg';
import igLogo from '../assets/icon/instagram.png';
import xLogo from '../assets/icon/twitter.png';
import placeholderImgVideo from '../assets/video/planet-jump.webp';
import multiplayerVideo from '../assets/video/planet-jump.mp4';
import singleplayerVideo from '../assets/video/planet-jump.mp4';
import "../styles/global.css";
---

<div id="container" class="min-h-screen relative">
	<div class='stars'></div>
	<div class='twinkling'></div>
	<div class='clouds'></div>

	<main class="relative z-10 flex flex-col space-y-8 md:space-y-12 lg:space-y-16 max-w-screen-lg mx-auto px-10 py-50">
		<section id="hero" class="text-white">
			<!-- <img src={astroLogo.src} width="115" height="48" alt="Astro Homepage" /> -->
			<section class="mb-10 w-full flex flex-col justify-center items-center">
				<h1 class="mb-2 text-5xl font-bold tracking-tight text-[rgb(0,244,253)] drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">
					Rift Jumper
				</h1>
				<h2 class="text-white drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">Survive the black hole, fight off enemies, collect space weapons.</h2>
			</section>
			<section id="links" class="mb-10 w-full flex items-center justify-center">



				<div class="relative items-center justify-center space-y-4 sm:flex sm:space-y-0 sm:space-x-4 rtl:space-x-reverse">
  
					<!-- Mac App Store Button -->
					<a href="#" class="soft-teal-glow w-full sm:w-auto bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-300 text-black rounded-lg inline-flex items-center justify-center px-4 py-2.5 shadow">
					  <svg class="me-3 w-7 h-7 text-black" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="apple" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
						<path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"></path>
					  </svg>
					  <div class="text-left rtl:text-right">
						<div class="mb-1 text-xs">Download on the</div>
						<div class="-mt-1 font-sans text-sm font-semibold">Mac App Store</div>
					  </div>
					</a>
				  
					<!-- Google Play Button -->
					<a href="#" class="soft-teal-glow w-full sm:w-auto bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-300 text-black rounded-lg inline-flex items-center justify-center px-4 py-2.5 shadow">
					  <svg class="me-3 w-7 h-7 text-black" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="google-play" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
						<path fill="currentColor" d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"></path>
					  </svg>
					  <div class="text-left rtl:text-right">
						<div class="mb-1 text-xs">Download at</div>
						<div class="-mt-1 font-sans text-sm font-semibold">Google Play</div>
					  </div>
					</a>
				  
				  </div>
				  

				
			</section>
			<section class="mb-10 w-full flex items-center justify-center">



					<!-- <div class="inline-flex rounded-md shadow-xs" role="group">
						<button type="button" data-src={multiplayerVideo} class="inline-flex items-center px-4 py-2 text-sm font-medium text-white-900 bg-transparent border-2 border-white-900 rounded-s-lg hover:bg-gray-900 hover:text-white focus:z-10 focus:ring-2 focus:ring-gray-500 focus:bg-gray-900 focus:text-white dark:border-white dark:text-white dark:hover:text-white dark:hover:bg-gray-700 dark:focus:bg-gray-700">
						<svg class="w-3 h-3 me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
							<path d="M10 0a10 10 0 1 0 10 10A10.011 10.011 0 0 0 10 0Zm0 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 13a8.949 8.949 0 0 1-4.951-1.488A3.987 3.987 0 0 1 9 13h2a3.987 3.987 0 0 1 3.951 3.512A8.949 8.949 0 0 1 10 18Z"/>
						</svg>
						Multiplayer
						</button>
						<button type="button" data-src={singleplayerVideo} class="inline-flex items-center px-4 py-2 text-sm font-medium text-white-900 bg-transparent border-2 border-white-900 rounded-e-lg hover:bg-gray-900 hover:text-white focus:z-10 focus:ring-2 focus:ring-gray-500 focus:bg-gray-900 focus:text-white dark:border-white dark:text-white dark:hover:text-white dark:hover:bg-gray-700 dark:focus:bg-gray-700">
						<svg class="w-3 h-3 me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
							<path d="M14.707 7.793a1 1 0 0 0-1.414 0L11 10.086V1.5a1 1 0 0 0-2 0v8.586L6.707 7.793a1 1 0 1 0-1.414 1.414l4 4a1 1 0 0 0 1.416 0l4-4a1 1 0 0 0-.002-1.414Z"/>
							<path d="M18 12h-2.55l-2.975 2.975a3.5 3.5 0 0 1-4.95 0L4.55 12H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2Zm-3 5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/>
						</svg>
						Single Player
						</button>
					</div> -->
					
					<div class="relative w-full border-2 rounded-lg shadow-sm border-teal-400/30 bg-transparent">
						<div class="teal-glow"></div>
						<video id="game-video" class="relative z-10 w-full rounded shadow-lg" controls autoplay muted>
							<source src={multiplayerVideo} type="video/mp4">
							Your browser does not support the video tag.
						</video>
					</div>



			</section>
		</section>
		<section id="updates" class="flex flex-col justify-center items-center mt-20 relative">


			<div class="relative w-full max-w-sm border-2 rounded-lg shadow-sm border-teal-400/30 bg-transparent">
				<div class="teal-glow delay-1"></div>
				<!-- <img class="object-cover w-full rounded-t-lg h-96 md:h-auto md:w-48 md:rounded-none md:rounded-s-lg" src="/docs/images/blog/image-4.jpg" alt=""> -->
				<div class="bg-black flex flex-col items-center pb-10 px-6 pt-6 relative z-10">
					<h5 class="mb-2 text-2xl font-bold tracking-tight text-[rgb(0,244,253)] drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">Beta Release 1.0</h5>
					<p class="mb-3 font-normal text-white drop-shadow-[0_0_8px_rgba(0,244,253,0.7)]">Game released! After hundreds of hours of effort, meetings, game concept changes, and development, the game is finally here! Get it on the App Store or the Google Play Store.</p>
					<section id="links mt-4 relative">
						<!-- Mac App Store Button -->
						<a href="#" class="soft-teal-glow w-full sm:w-auto bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-300 text-black rounded-lg inline-flex items-center justify-center px-4 py-2.5 shadow">
							<svg class="me-3 w-7 h-7 text-black" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="apple" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
							<path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"></path>
							</svg>
							<div class="text-left rtl:text-right">
							<div class="mb-1 text-xs">Download on the</div>
							<div class="-mt-1 font-sans text-sm font-semibold">Mac App Store</div>
							</div>
						</a>
						
						<!-- Google Play Button -->
						<a href="#" class=" soft-teal-glow w-full sm:w-auto bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-300 text-black rounded-lg inline-flex items-center justify-center px-4 py-2.5 shadow">
							<svg class="me-3 w-7 h-7 text-black" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="google-play" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
							<path fill="currentColor" d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"></path>
							</svg>
							<div class="text-left rtl:text-right">
							<div class="mb-1 text-xs">Get in on</div>
							<div class="-mt-1 font-sans text-sm font-semibold">Google Play</div>
							</div>
						</a>
					</section>
				</div>
			</div>


		</section>

		<section id="notifs" class="flex flex-col gap-16 md:flex-row md:space-x-8 space-y-8 md:space-y-0 justify-center mt-20">
			

			<div class="relative w-full max-w-sm border-2 rounded-lg shadow-sm border-teal-400/30 bg-transparent">
				<div class="teal-glow delay-2"></div>
			  
				<div class="bg-black relative z-10 flex flex-col items-center pb-10 px-6 pt-6">
					<img class="w-24 h-24 mb-3 rounded-full shadow-lg ring-4 ring-[rgba(0,244,253,0.7)] soft-teal-glow" 
							src={xLogo.src}
							alt="X" />
					
					<h5 class="mb-1 text-xl font-medium text-[rgb(0,244,253)] drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">
						Discord
					</h5>
					
					<span class="text-sm text-white drop-shadow-[0_0_8px_rgba(0,244,253,0.7)] text-center">
						Join our community and talk to friends who play.
					</span>
					
					<div class="flex mt-4 md:mt-6">
						<a href="#" class="inline-flex items-center px-4 py-2 text-sm font-medium text-black bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-white/50">
						Follow us
													<svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
							</svg>
						</a>
					</div>
				
				</div>
			</div>

			<div class="relative w-full max-w-sm border-2 group rounded-lg shadow-sm border-teal-400/30  bg-transparent relative">
				<div class="teal-glow"></div>

				<!-- Card content -->
				<div class="bg-black flex flex-col items-center pb-10 px-6 pt-6 relative z-10">
					<img class="w-24 h-24 mb-3 rounded-full shadow-lg ring-4 ring-[rgba(0,244,253,0.7)] soft-teal-glow" 
							src={igLogo.src} 
							alt="Instagram" />
					
					<h5 class="mb-1 text-xl font-medium text-[rgb(0,244,253)] drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">
						Instagram
					</h5>
					
					<span class="text-sm text-white drop-shadow-[0_0_8px_rgba(0,244,253,0.7)] text-center">
						Major releases and upcoming features
					</span>
					
					<div class="flex mt-4 md:mt-6">
						<a href="#" class="inline-flex items-center px-4 py-2 text-sm font-medium text-black bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-white/50">
						See the updates
						<svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
							<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
						</svg>
						</a>
					</div>
				
				</div>
			</div>
	   
			  
		</section>

		<section id="devs" class="flex flex-col gap-16 md:flex-row md:space-x-8 space-y-8 md:space-y-0 justify-center mt-20">

			<div class="relative w-full max-w-sm border-2 group rounded-lg shadow-sm border-teal-400/30  bg-transparent relative">
				<div class="teal-glow delay-3"></div>
			  
				<div class="bg-black flex flex-col items-center relative z-10">
					<a href="#">
						<img class="rounded-t-lg" src="https://alexzahnaudio.com/assets/img/about.png" alt="" />
					</a>
					<div class="p-5">
						<a href="#">
							<h5 class="mb-2 text-2xl font-bold tracking-tight text-[rgb(0,244,253)] drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">Alex Zahn</h5>
						</a>
						<p class="mb-3 font-normal text-white drop-shadow-[0_0_8px_rgba(0,244,253,0.7)]">Lead developer, game designer, audio engineer, co-founder.</p>
						
						<a href="#" class="inline-flex items-center px-4 py-2 text-sm font-medium text-black bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-white/50">
							Twitter
							<svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
							</svg>
						</a>
					</div>
				</div>
			</div>

			<div class="relative flex w-full max-w-sm border-2 group rounded-lg shadow-sm border-teal-400/30  bg-transparent relative">
				<div class="teal-glow delay-5"></div>
		  
				<div class="bg-black flex-1 flex flex-col items-center relative z-10">
					<a href="#">
						<img class="rounded-t-lg" src="https://www.landfx.com/images/elements/who-we-are/people/kyler.jpg" alt="" />
					</a>
					<div class="p-5">
						<a href="#">
							<h5 class="mb-2 text-2xl font-bold tracking-tight text-[rgb(0,244,253)] drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">Kyler Gronner</h5>
						</a>
						<p class="mb-3 font-normal text-white drop-shadow-[0_0_8px_rgba(0,244,253,0.7)]">Developer, game designer, co-founder.</p>
						<a href="#" class="inline-flex items-center px-4 py-2 text-sm font-medium text-black bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-white/50">
							LinkedIn
							<svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
							</svg>
						</a>
					</div>
				</div>

		</section>
	</main>

	
</div>

<script type="module" src="/src/js/page.js" defer></script>
