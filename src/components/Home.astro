---
import ship1 from '../assets/image/ship-1.png';
import ship2 from '../assets/image/ship-2.png';
import ship3 from '../assets/image/ship-3.png';
import ship4 from '../assets/image/ship-4.png';
import bodyEarth from '../assets/image/body-earth.png';
import bodyFire from '../assets/image/body-fire.png';
import bodyGas from '../assets/image/body-gas.png';
import bodyIce from '../assets/image/body-ice.png';
import kylerPhoto from '../assets/image/kyler.jpg';
import gameplayPoster from '../assets/video/planet-jump.png';
import gameplayVideo from '../assets/video/planet-jump.mp4';
import "../styles/global.css";
import "../styles/rift.css";

const ships = [
	{ src: ship1, alt: 'Ship 1' },
	{ src: ship2, alt: 'Ship 2' },
	{ src: ship3, alt: 'Ship 3' },
	{ src: ship4, alt: 'Ship 4' },
];

const worlds = [
	{ src: bodyEarth, name: 'Earth' },
	{ src: bodyFire, name: 'Fire' },
	{ src: bodyGas, name: 'Gas' },
	{ src: bodyIce, name: 'Ice' },
];

const run = ['Survive the black hole.', 'Fight off enemies.', 'Collect space weapons.'];

const appleIcon = 'M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z';
const playIcon = 'M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z';
---

<div class="rift" data-rift>
	<canvas class="rift-bg" aria-hidden="true"></canvas>
	<canvas class="rift-fg" aria-hidden="true"></canvas>
	<div class="rift-fallback" aria-hidden="true"></div>

	<header class="rift-section rift-hero">
		<div data-suck style="width: 100%;">
			<div class="rift-logo-wrap">
				<p class="rift-eyebrow">Beta 1.0 · Out now</p>
				<h1 class="rift-logo" aria-label="Rift Jumpers">
					<span class="rift-logo-row" aria-hidden="true">
						<span class="rift-scanline">Rift</span>
						<span class="rift-speedlines"><span></span><span></span><span></span><span></span></span>
					</span>
					<span class="rift-scanline" aria-hidden="true">Jumpers</span>
				</h1>
			</div>
		</div>

		<div data-suck>
			<p class="rift-tagline">Survive the black hole, fight off enemies, collect space weapons.</p>
		</div>

		<div class="rift-stores">
			<div data-suck>
				<a href="#" class="rift-store rift-light">
					<svg aria-hidden="true" viewBox="0 0 384 512"><path fill="currentColor" d={appleIcon}></path></svg>
					<span class="rift-store-text">
						<span class="rift-store-small">Download on the</span>
						<span class="rift-store-name">Mac App Store</span>
					</span>
				</a>
			</div>
			<div data-suck>
				<a href="#" class="rift-store rift-ghost">
					<svg aria-hidden="true" viewBox="0 0 512 512" style="width: 22px; height: 22px;"><path fill="currentColor" d={playIcon}></path></svg>
					<span class="rift-store-text">
						<span class="rift-store-small" style="color: #c3ccda;">Get it on</span>
						<span class="rift-store-name">Google Play</span>
					</span>
				</a>
			</div>
		</div>

		<div data-suck>
			<p class="rift-scroll-cue">
				Scroll to feed the rift
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M6 9l6 6 6-6"></path></svg>
			</p>
		</div>
	</header>

	<section class="rift-section" style="padding-top: 112px;">
		<div data-suck>
			<figure class="rift-video">
				<div class="rift-video-frame">
					<video id="game-video" poster={gameplayPoster.src} preload="metadata" playsinline>
						<source src={gameplayVideo} type="video/mp4" />
						Your browser does not support the video tag.
					</video>
					<button id="game-video-play" type="button" class="rift-play" aria-label="Play gameplay video">
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="#05060b" stroke="#05060b" stroke-width="1.5" stroke-linejoin="round"><path d="M7 4.5v15l12-7.5z"></path></svg>
					</button>
				</div>
				<figcaption class="rift-caption">Multiplayer gameplay</figcaption>
			</figure>
		</div>
	</section>

	<section class="rift-section">
		<div data-suck>
			<p class="rift-eyebrow">The run</p>
		</div>
		<ol class="rift-run">
			{run.map((line, i) => (
				<li data-suck>
					<div class="rift-run-item">
						<span class="rift-run-num">{String(i + 1).padStart(2, '0')}</span>
						<span class="rift-display rift-run-text">{line}</span>
					</div>
				</li>
			))}
		</ol>
	</section>

	<section class="rift-section">
		<div data-suck>
			<div class="rift-heading">
				<p class="rift-eyebrow">From the game</p>
				<h2 class="rift-display rift-h2">Ships &amp; worlds</h2>
			</div>
		</div>
		<div class="rift-grid rift-grid-4">
			{ships.map((ship) => (
				<div data-suck>
					<div class="rift-tile"><img src={ship.src.src} alt={ship.alt} loading="lazy" /></div>
				</div>
			))}
		</div>
		<div class="rift-grid rift-grid-4">
			{worlds.map((world) => (
				<div data-suck>
					<div class="rift-world">
						<img src={world.src.src} alt="" loading="lazy" />
						<span class="rift-display">{world.name}</span>
					</div>
				</div>
			))}
		</div>
	</section>

	<section class="rift-section">
		<div data-suck>
			<article class="rift-dispatch">
				<div class="rift-heading">
					<p class="rift-eyebrow">Dispatch</p>
					<h2 class="rift-display">Beta Release 1.0</h2>
				</div>
				<div class="rift-heading" style="gap: 24px;">
					<p class="rift-body">Game released! After hundreds of hours of effort, meetings, game concept changes, and development, the game is finally here! Get it on the App Store or the Google Play Store.</p>
					<div class="rift-actions">
						<a href="#" class="rift-btn rift-light" style="min-height: 48px; padding: 0 20px;">Mac App Store</a>
						<a href="#" class="rift-btn rift-ghost" style="min-height: 48px; padding: 0 20px;">Google Play</a>
					</div>
				</div>
			</article>
		</div>
	</section>

	<section class="rift-section">
		<div data-suck>
			<div class="rift-heading">
				<p class="rift-eyebrow">Stay in orbit</p>
				<h2 class="rift-display rift-h2">Community</h2>
			</div>
		</div>
		<div class="rift-grid">
			<div data-suck>
				<article class="rift-card">
					<div class="rift-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.6A8 8 0 1 1 21 12z"></path><path d="M9 11.5h.01M15 11.5h.01"></path></svg>
					</div>
					<h3 class="rift-display">Discord</h3>
					<p class="rift-body">Join our community and talk to friends who play.</p>
					<a href="#" class="rift-btn rift-light">
						Join the server
						<svg aria-hidden="true" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5h12m0 0L9 1m4 4L9 9"></path></svg>
					</a>
				</article>
			</div>
			<div data-suck>
				<article class="rift-card">
					<div class="rift-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17 7h.01"></path></svg>
					</div>
					<h3 class="rift-display">Instagram</h3>
					<p class="rift-body">Major releases and upcoming features.</p>
					<a href="#" class="rift-btn rift-light">
						See the updates
						<svg aria-hidden="true" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5h12m0 0L9 1m4 4L9 9"></path></svg>
					</a>
				</article>
			</div>
		</div>
	</section>

	<section class="rift-section">
		<div data-suck>
			<div class="rift-heading">
				<p class="rift-eyebrow">Built by</p>
				<h2 class="rift-display rift-h2">The team</h2>
			</div>
		</div>
		<div class="rift-grid">
			<div data-suck>
				<article class="rift-card rift-member">
					<div class="rift-photo">
						<span aria-hidden="true">AZ</span>
						<img src="https://alexzahnaudio.com/assets/img/about.png" alt="Portrait of Alex Zahn" loading="lazy" />
					</div>
					<div class="rift-member-body">
						<h3 class="rift-display">Alex Zahn</h3>
						<p class="rift-body">Lead developer, game designer, audio engineer, co-founder.</p>
						<a href="#" class="rift-btn rift-ghost">
							Twitter
							<svg aria-hidden="true" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5h12m0 0L9 1m4 4L9 9"></path></svg>
						</a>
					</div>
				</article>
			</div>
			<div data-suck>
				<article class="rift-card rift-member">
					<div class="rift-photo">
						<span aria-hidden="true">KG</span>
						<img src={kylerPhoto.src} alt="Kyler Gronner on a campus bench holding two white dogs" loading="lazy" style="object-position: 50% 30%;" />
					</div>
					<div class="rift-member-body">
						<h3 class="rift-display">Kyler Gronner</h3>
						<p class="rift-body">Developer, game designer, co-founder.</p>
						<a href="#" class="rift-btn rift-ghost">
							LinkedIn
							<svg aria-hidden="true" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5h12m0 0L9 1m4 4L9 9"></path></svg>
						</a>
					</div>
				</article>
			</div>
		</div>
	</section>

	<footer class="rift-section">
		<div data-suck>
			<div class="rift-footer-bar">
				<span class="rift-wordmark">Rift Jumpers</span>
				<nav class="rift-footer-nav" aria-label="Footer">
					<a href="#">Mac App Store</a>
					<a href="#">Google Play</a>
					<a href="#">Discord</a>
					<a href="#">Instagram</a>
					<a href="/privacy-policy">Privacy Policy</a>
					<a href="/delete-account">Delete Account</a>
				</nav>
			</div>
		</div>
	</footer>

	<div class="rift-end">
		<p>Event horizon reached<br />Scroll up — everything comes back out</p>
	</div>
</div>

<script>
	import '../js/black-hole.js';
	import '../js/page.js';
</script>
