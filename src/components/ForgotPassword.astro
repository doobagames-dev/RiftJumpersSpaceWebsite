---
import igLogo from '../assets/icon/instagram.png';
import xLogo from '../assets/icon/twitter.png';
import "../styles/global.css";
---

<div id="container" class="min-h-screen relative">
  <div class='stars'></div>
  <div class='twinkling'></div>
  <div class='clouds'></div>

  <main class="relative z-10 flex flex-col space-y-8 md:space-y-12 lg:space-y-16 max-w-screen-lg mx-auto px-10 py-50">
    <section id="hero" class="text-white w-full flex flex-col items-center">
      <h1 class="mb-2 text-5xl font-bold tracking-tight text-[rgb(0,244,253)] drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">
        Reset your password
      </h1>
      <h2 class="mb-4 text-white drop-shadow-[0_0_10px_rgba(0,244,253,0.9)]">Enter your new password.</h2>

	  <div class="flex flex-col w-full max-w-md gap-2">
		<div class="relative w-full max-w-sm border-2 group rounded-lg shadow-sm border-teal-400/30  bg-transparent relative">
			<input id="pass1" type="password" placeholder="New Password"
			class="text-white caret-white  w-full max-w-md px-4 py-2 text-black rounded shadow focus:outline-none border border-teal-300 bg-black z-10 relative" />
		</div>

		<div class="relative w-full max-w-sm border-2 group rounded-lg shadow-sm border-teal-400/30  bg-transparent relative">
			<input id="pass2" type="password" placeholder="Confirm Password"
			class="text-white caret-white w-full max-w-md px-4 py-2 text-black rounded shadow focus:outline-none border border-teal-300 bg-black z-10 relative" />
		</div>


		<p id="error" class="text-red-500 text-sm h-5 mt-1"></p>

		</div>
      <button id="submit" class="mt-4 px-6 py-2 rounded text-black font-semibold bg-white drop-shadow-[0_0_12px_rgba(0,244,253,1)] cursor-pointer focus:outline-none transition-all duration-200">
        Change Password
      </button>
    </section>

    <!-- Your existing social section remains unchanged -->
    <!-- ... -->
  </main>
</div>

<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const urlParams = new URLSearchParams(window.location.search);
    const userId = urlParams.get("user_id");
    const accessToken = urlParams.get("access_token");

    const pass1 = document.getElementById("pass1");
    const pass2 = document.getElementById("pass2");
    const error = document.getElementById("error");
    const submit = document.getElementById("submit");

    function validateMatch() {
      if (pass1.value !== pass2.value) {
        error.textContent = "Passwords must match.";
        return false;
      } else {
        error.textContent = "";
        return true;
      }
    }

    pass1.addEventListener("input", validateMatch);
    pass2.addEventListener("input", validateMatch);

    submit.addEventListener("click", async () => {
      if (!validateMatch()) return;

      if (!userId || !accessToken) {
        alert("Missing URL parameters.");
        return;
      }

      const payload = {
        user_id: userId,
        access_token: accessToken,
        new_password: pass1.value
      };

      try {
        const response = await fetch("https://10.10.101.0/change_password", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(payload)
        });

        if (response.status === 200) {
          const data = await response.json();
          if (data.success) {
            alert(data.message);
          } else {
            alert(data.message || "An error occurred.");
          }
        } else {
          alert("Could not reach the server.");
        }
      } catch (err) {
        alert("Network error. Please try again later.");
      }
    });
  });
</script>
